# Copy to `.env` and fill in locally. `.env` is git-ignored: NEVER commit real values.
# Secrets must never go into config/*.yaml, the database, logs or the frontend (ADR-0005).

# --- Data providers (see docs/data-sources.md) ----------------------------------
# Historical base: football-data.co.uk CSVs need no key.
FOOTBALL_DATA_ORG_API_KEY=      # optional, secondary fixtures source
SPORTMONKS_API_TOKEN=           # stats incl. per-half corners (pending ADR-0007)
API_FOOTBALL_KEY=               # alternative/secondary stats source (pending ADR-0007)
SPORTRADAR_API_KEY=             # only with a contract

# --- Odds -------------------------------------------------------------------------
ODDS_API_KEY=

# --- Infrastructure -----------------------------------------------------------------
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=

# --- This system's own API (later phase). Not shared with JEV Trading. -----------
JEV_SPORTS_API_TOKEN=

# --- Config overrides (optional): JEVS__<SECTION>__<KEY>=value --------------------
