# Secrets: never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Data (only small fixtures are versioned)
data/*
!data/fixtures/

# Node
node_modules/
dist/

# Build and generated experiment outputs (published reports are copied to experiments/*/runs/)
*.egg-info/
experiments/*/results/
